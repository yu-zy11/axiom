{
  "auto_advance_stage": true,
  "stage_catalog": "automation/agent_stage_plans.json",
  "stage_plan": {
  "stage": 3,
  "roadmap": "docs/plan/AxiomKernel_主开发计划与阶段路线图.md",
  "tasks": [
    {
      "id": "S3-QUERY",
      "requirement_id": "FR-QUERY-001",
      "goal": "关闭已支持 Stage 3 体类的截面与最近点/最近距离主链；优先修复通用 QueryService 的 bbox 占位及与专用接口不一致的失败、空结果语义。",
      "acceptance": [
        "对已声明支持的真实建模体计算实际平面截面；用非轴对齐与凹/带孔案例证明不返回 bbox 角点伪截面。",
        "最近点/最近距离使用实际几何或真实拓扑边界；独立参考值覆盖 bbox 重叠但实体分离及相切场景。",
        "明确精确/采样计算和不支持范围；不支持输入返回稳定错误码及 Issue.stage，空交集语义一致。",
        "成功、退化、失败及查询不污染模型/缓存/Eval/事务的回归齐全。"
      ],
      "tests": [
        "axiom_query_eval_test",
        "axiom_ops_heal_test"
      ],
      "depends_on": []
    },
    {
      "id": "S3-MASS",
      "requirement_id": "FR-QUERY-001",
      "goal": "统一 Stage 3 已支持模型的体积、面积、重心和惯性，消除静默 bbox 质量回退和来源记录与实际拓扑漂移。",
      "acceptance": [
        "已支持的 primitive 和 extrude/revolve/sweep/loft/thicken 质量属性有独立解析或数值参考，说明采样误差。",
        "公开质量查询与当前拓扑/表示一致；编辑后重新查询、回滚恢复和多壳材料/空腔语义有回归。",
        "未知或不支持体类不以 bbox 质量冒充正确结果；失败有稳定诊断阶段且无部分数值。"
      ],
      "tests": [
        "axiom_query_eval_test",
        "axiom_ops_heal_test",
        "axiom_representation_io_test"
      ],
      "depends_on": [
        "S3-QUERY"
      ]
    },
    {
      "id": "S3-MODELING",
      "requirement_id": "FR-OPS-001",
      "goal": "核验并补齐 Stage 3 五类建模主路径；只修复退出要求缺口，已有路径满足时补验收，不继续扩展无关变体。",
      "kind": "acceptance",
      "acceptance": [
        "extrude/revolve/sweep/loft/thicken 各有一条非占位、非 bbox 近似的真实拓扑主路径并通过 Strict 验证。",
        "每条主路径覆盖公开面/边/壳查询、实际表示与质量属性，精确或采样属性明确。",
        "边界/退化/不支持输入有结构化诊断；活动事务失败不污染，回滚后可重试。"
      ],
      "tests": [
        "axiom_ops_heal_test",
        "axiom_topology_test"
      ],
      "depends_on": [
        "S3-MASS"
      ]
    },
    {
      "id": "S3-CONSISTENCY",
      "requirement_id": "FR-OPS-001",
      "goal": "打通基础零件建模到查询、表示、来源和 Eval 的一致性验收，修复失败回滚与 fallback 漂移。",
      "kind": "acceptance",
      "acceptance": [
        "代表性基础零件通过建模→验证→截面/距离/质量查询→表示转换的集成闭环。",
        "topology/rep/provenance/eval 对同一主链结果一致，关联实体有效。",
        "修改/失败/回滚后的拓扑、表示、来源与 Eval 状态一致并有回归。"
      ],
      "tests": [
        "axiom_ops_heal_test",
        "axiom_query_eval_test",
        "axiom_representation_io_test",
        "axiom_kernel_runtime_invariant_test"
      ],
      "depends_on": [
        "S3-MODELING"
      ]
    },
    {
      "id": "S3-EXIT",
      "requirement_id": "FR-QUERY-001",
      "goal": "按主路线图 Stage 3 退出标准收口统一支持矩阵、阶段证据和文档；不把工业功能需求全部满足作为 Stage 3 完成前提。",
      "kind": "acceptance",
      "acceptance": [
        "统一支持矩阵映射体类、五类建模、截面/最近点/距离/质量、精确/采样/不支持范围及自动化证据。",
        "Stage 3 退出项逐条对应集成回归，未纳入本阶段的工业能力明确保留限制。",
        "完整构建/CTest 和文档检查通过后同步当前进度、需求矩阵及 Backlog；压缩所涉历史 strict warnings，记录残余告警。"
      ],
      "tests": [
        "axiom_ops_heal_test",
        "axiom_query_eval_test",
        "axiom_representation_io_test",
        "axiom_kernel_runtime_invariant_test",
        "axiom_smoke_test"
      ],
      "depends_on": [
        "S3-CONSISTENCY"
      ]
    }
  ]
},
  "agent_command": ["codex", "exec", "--sandbox", "workspace-write", "-"],
  "build_dir": "build-agent",
  "build_parallel_jobs": 4,
  "batch_enabled": true,
  "batch_min_packages": 3,
  "batch_min_code_lines": 1000,
  "batch_max_packages": 8,
  "docs_timeout_seconds": 900,
  "full_test_interval": 5,
  "unlocked_tiers": 2,
  "requirement_weights": {"FR-OPS-001": 5, "FR-QUERY-001": 2},
  "task_briefs": {
    "FR-OPS-001": {
      "goal": "选定拉伸、旋转或扫掠中的一个完整特征功能包，集中实现主流程、相关轮廓/方向变体、拓扑查询和退化/事务回归，再统一构建验收；输出应通过拓扑验证器并可由公开 API 查询实际面、边和体，不能仅新增 bbox 或统计记录。",
      "entrypoints": ["src/axiom/ops/ops_services.cpp", "src/axiom/internal/core/topology_materialization.h", "tests/ops/ops_heal_test.cpp"]
    },
    "FR-QUERY-001": {
      "goal": "交付一组围绕同一模型或算法的完整几何/拓扑查询能力，集中完成公开 API、共享计算、单位、空结果、修改/回滚语义和跨模块回归后统一验收，避免将同一接口族拆成多轮零散查询。",
      "entrypoints": ["include/axiom/geo/geometry_services.h", "include/axiom/topo/topology_service.h", "tests/eval/query_eval_test.cpp"]
    },
    "FR-BOOL-001": {
      "goal": "选定有明确输入支持范围的完整布尔功能包，打通该范围所需的真实求交、切分、分类和重建链路并集中补齐回归，再统一验收；成功结果需通过拓扑验证器，不把 bbox 或 mesh 近似宣称为精确布尔。",
      "entrypoints": ["src/axiom/ops/ops_services.cpp", "tests/ops/boolean_workflow_test.cpp"]
    }
  },
  "max_consecutive_failures": 0,
  "retry_delay_seconds": 10,
  "agent_timeout_seconds": 3600,
  "protected_branches": ["main", "master"],
  "requirement_tiers": [
    ["FR-GEO-001", "FR-TOPO-001", "NFR-REL-001", "FR-DIAG-001", "NFR-DIA-001"],
    ["FR-OPS-001", "FR-QUERY-001"],
    ["FR-BOOL-001"],
    ["FR-HEAL-001", "FR-IO-001", "FR-REP-001"],
    ["FR-MOD-001", "FR-BLEND-001"],
    ["FR-EVAL-001"],
    ["FR-PLUGIN-001", "FR-HYBRID-001", "NFR-PERF-001", "NFR-COMP-001", "NFR-OBS-001", "NFR-SEC-001"]
  ],
  "module_tests": {
    "Performance": ["axiom_perf_baseline_test"],
    "Core": ["axiom_kernel_runtime_invariant_test", "axiom_smoke_test"],
    "Math": ["axiom_math_services_test"],
    "Geo": ["axiom_geometry_test"],
    "Topo": ["axiom_topology_test"],
    "Rep": ["axiom_representation_io_test"],
    "Ops": ["axiom_ops_heal_test", "axiom_boolean_prep_test", "axiom_boolean_workflow_test"],
    "Heal": ["axiom_heal_test", "axiom_ops_heal_test"],
    "Eval": ["axiom_query_eval_test"],
    "IO": ["axiom_io_workflow_test", "axiom_io_dataset_test"],
    "Plugin": ["axiom_plugin_sdk_test"],
    "SDK": ["axiom_smoke_test", "axiom_plugin_sdk_test"],
    "Diagnostics": ["axiom_diagnostics_test"]
  }
}
